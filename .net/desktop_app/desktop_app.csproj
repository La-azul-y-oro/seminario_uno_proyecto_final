      <SubType>Form</SubType>
    </Compile>
    <Compile Update="supplier\SupplierControl.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="concept\ConceptForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="supplier\SupplierForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="consortium\ConsortiumForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>

</Project>
